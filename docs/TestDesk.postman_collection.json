{
  "info": {
    "name": "TestDesk — Online Examination API",
    "description": "Run the folders top to bottom: logins store tokens, and create requests store ids (courseId, examId, …) in collection variables for the next calls.\n\nSet baseUrl to your server (e.g. http://localhost:5001/api or your Render URL + /api). The admin login uses ADMIN_EMAIL / ADMIN_PASSWORD from .env.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001/api"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "instructorToken",
      "value": ""
    },
    {
      "key": "studentToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "instructorId",
      "value": ""
    },
    {
      "key": "courseId",
      "value": ""
    },
    {
      "key": "questionId",
      "value": ""
    },
    {
      "key": "codingQuestionId",
      "value": ""
    },
    {
      "key": "examId",
      "value": ""
    },
    {
      "key": "attemptId",
      "value": ""
    },
    {
      "key": "optionId",
      "value": ""
    },
    {
      "key": "resultId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Uses ADMIN_EMAIL / ADMIN_PASSWORD from .env (the .env.example defaults are shown).",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@testdesk.dev\",\n  \"password\": \"Admin@12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success) pm.collectionVariables.set('adminToken', json.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register a student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Run once. If the email already exists, use \"Login as student\" instead.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Riya Sharma\",\n  \"email\": \"riya@example.com\",\n  \"password\": \"Student@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success) pm.collectionVariables.set('studentToken', json.data.token);"
